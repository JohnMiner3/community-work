[0m14:58:40.115161 [debug] [Thread-1 (]: On model.chinook.Dates02: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "chinook", "target_name": "dev", "node_id": "model.chinook.Dates02"} */

  
    

  create  table "chinook01"."data_stage"."Dates02__dbt_tmp"
  
  
    as
  
  (
    

WITH date_spine AS (
  





with rawdata as (

    

    

    with p as (
        select 0 as generated_number union all select 1
    ), unioned as (

    select

    
    p0.generated_number * power(2, 0)
     + 
    
    p1.generated_number * power(2, 1)
     + 
    
    p2.generated_number * power(2, 2)
     + 
    
    p3.generated_number * power(2, 3)
     + 
    
    p4.generated_number * power(2, 4)
     + 
    
    p5.generated_number * power(2, 5)
     + 
    
    p6.generated_number * power(2, 6)
     + 
    
    p7.generated_number * power(2, 7)
     + 
    
    p8.generated_number * power(2, 8)
     + 
    
    p9.generated_number * power(2, 9)
     + 
    
    p10.generated_number * power(2, 10)
     + 
    
    p11.generated_number * power(2, 11)
     + 
    
    p12.generated_number * power(2, 12)
     + 
    
    p13.generated_number * power(2, 13)
    
    
    + 1
    as generated_number

    from

    
    p as p0
     cross join 
    
    p as p1
     cross join 
    
    p as p2
     cross join 
    
    p as p3
     cross join 
    
    p as p4
     cross join 
    
    p as p5
     cross join 
    
    p as p6
     cross join 
    
    p as p7
     cross join 
    
    p as p8
     cross join 
    
    p as p9
     cross join 
    
    p as p10
     cross join 
    
    p as p11
     cross join 
    
    p as p12
     cross join 
    
    p as p13
    
    

    )

    select *
    from unioned
    where generated_number <= 10958
    order by generated_number



),

all_periods as (

    select (
        

    CAST('2015-01-01' AS DATE) + ((interval '1 day') * (row_number() over (order by generated_number) - 1))


    ) as date_day
    from rawdata

),

filtered as (

    select *
    from all_periods
    where date_day <= CAST('2045-01-01' AS DATE)

)

select * from filtered


),

-- Add other date attributes
date_details AS (
  SELECT
    
        (('2015-01-01')::date - (date_day)::date)
     AS DateId,
    cast("date_day" as timestamp) AS DateValue,
    date_part('year', date_day) AS CalendarYear,
    date_part('month', date_day) AS CalendarMonth,
    date_part('day', date_day) AS CalendarDay
  FROM
    date_spine
)

SELECT
  *
FROM
  date_details
  );
  
