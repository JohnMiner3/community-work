[0m15:03:32.578188 [debug] [Thread-1 (]: On model.chinook.DimProducts: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "chinook", "target_name": "dev", "node_id": "model.chinook.DimProducts"} */

  
    

  create  table "chinook01"."data_mart"."DimProducts__dbt_tmp"
  
  
    as
  
  (
    select 
	md5(cast(coalesce(cast(art."Name" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(alb."Title" as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trk."TrackId" as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS ProductId,
	trk."TrackId" as "TrackId",
	art."Name" as "ArtistName",
	alb."Title" as "AlbumTitle",
	med."Name" as "MediaType",
	gen."Name" as "Genre",
	trk."Composer" as "Composer",
	trk."Milliseconds" as "Milliseconds",
	trk."Bytes" as "Bytes",
	trk."UnitPrice" as "UnitPrice"
from "chinook01"."data_snapshot"."Track02" as trk
join "chinook01"."data_snapshot"."Album02" as alb
on
	trk."AlbumId" = alb."AlbumId"
join "chinook01"."data_snapshot"."Artist02" as art
on
	alb."ArtistId" = art."ArtistId"
join "chinook01"."data_snapshot"."MediaType02" as med
on
	trk."MediaTypeId" = med."MediaTypeId"
join "chinook01"."data_snapshot"."Genre02" as gen
on
	trk."GenreId" = gen."GenreId"

-- Apply effective date logic
where
	(trk."dbt_updated_at" >= alb."dbt_valid_from" and 
	trk."dbt_updated_at" <= 
  COALESCE(
    alb.dbt_valid_to,
    CAST('2100-01-01' AS DATE)
  )
 )

	and
	(trk."dbt_updated_at" >= art."dbt_valid_from" and 
	trk."dbt_updated_at" <= 
  COALESCE(
    art.dbt_valid_to,
    CAST('2100-01-01' AS DATE)
  )
 )

	and
	(trk."dbt_updated_at" >= med."dbt_valid_from" and 
	trk."dbt_updated_at" <= 
  COALESCE(
    med.dbt_valid_to,
    CAST('2100-01-01' AS DATE)
  )
 )

	and
	(trk."dbt_updated_at" >= gen."dbt_valid_from" and 
	trk."dbt_updated_at" <= 
  COALESCE(
    gen.dbt_valid_to,
    CAST('2100-01-01' AS DATE)
  )
 )
  );
  
