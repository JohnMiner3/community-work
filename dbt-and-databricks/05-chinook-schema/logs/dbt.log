    EXEC('
        create view "data_stage"."Dates01__dbt_tmp__dbt_tmp_vw" as 

--
--  Uses sys.all_objects cross join to avoid recursive CTE + OPTION (MAXRECURSION) issue
--

WITH numbers AS (
    SELECT TOP (DATEDIFF(DAY, ''2015-01-01'', ''2045-01-01'') + 1)
        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects a
    CROSS JOIN sys.all_objects b
),

dates AS (
    SELECT DATEADD(DAY, n, CAST(''2015-01-01'' AS DATE)) AS date_day
    FROM numbers
)

SELECT 
    date_day,
    YEAR(date_day) AS year_actual,
    MONTH(date_day) AS month_actual,
    DATENAME(month, date_day) AS month_name,
    DATEPART(quarter, date_day) AS quarter_actual,
    DATENAME(weekday, date_day) AS day_name
FROM dates;;
    ')

EXEC('
            SELECT * INTO "chinook00"."data_stage"."Dates01__dbt_tmp" FROM "chinook00"."data_stage"."Dates01__dbt_tmp__dbt_tmp_vw" 
    OPTION (LABEL = ''dbt-sqlserver'');

        ')

    
