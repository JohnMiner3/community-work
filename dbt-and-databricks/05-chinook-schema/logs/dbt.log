    USE [chinook00];
    EXEC('
        create view "data_mart"."DimProducts__dbt_tmp__dbt_tmp_vw" as select 
	
    
    lower(convert(varchar(50), hashbytes(''md5'', coalesce(convert(varchar(8000), concat(coalesce(cast(art.Name as VARCHAR(8000)), ''_dbt_utils_surrogate_key_null_''), ''-'', coalesce(cast(alb.Title as VARCHAR(8000)), ''_dbt_utils_surrogate_key_null_''), ''-'', coalesce(cast(trk.TrackId as VARCHAR(8000)), ''_dbt_utils_surrogate_key_null_''))), '''')), 2))
 AS ProductId,
	trk.TrackId,
	art.Name as ArtistName,
	alb.Title as AlbumTitle,
	med.Name as MediaType,
	gen.Name as Genre,
	trk.Composer,
	trk.Milliseconds,
	trk.Bytes,
	trk.UnitPrice
from "chinook00"."data_snapshot"."Track02" as trk
join "chinook00"."data_snapshot"."Album02" as alb
on
	trk.AlbumId = alb.AlbumId
join "chinook00"."data_snapshot"."Artist02" as art
on
	alb.ArtistId = art.ArtistId
join "chinook00"."data_snapshot"."MediaType02" as med
on
	trk.MediaTypeId = med.MediaTypeId
join "chinook00"."data_snapshot"."Genre02" as gen
on
	trk.GenreId = gen.GenreId

-- Apply effective date logic
where
	(trk.dbt_updated_at >= alb.dbt_valid_from and 
	trk.dbt_updated_at <= 
  COALESCE(
    alb.dbt_valid_to,
    CAST(''2100-01-01'' AS DATE)
  )
 )

	and
	(trk.dbt_updated_at >= art.dbt_valid_from and 
	trk.dbt_updated_at <= 
  COALESCE(
    art.dbt_valid_to,
    CAST(''2100-01-01'' AS DATE)
  )
 )

	and
	(trk.dbt_updated_at >= med.dbt_valid_from and 
	trk.dbt_updated_at <= 
  COALESCE(
    med.dbt_valid_to,
    CAST(''2100-01-01'' AS DATE)
  )
 )

	and
	(trk.dbt_updated_at >= gen.dbt_valid_from and 
	trk.dbt_updated_at <= 
  COALESCE(
    gen.dbt_valid_to,
    CAST(''2100-01-01'' AS DATE)
  )
 );
    ')

